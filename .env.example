PORT=8787
HOST=127.0.0.1
DB_PATH=./data/facevision.sqlite
# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to https://jalen3495-glitch.github.io,https://facevision.js.org when unset.
ALLOWED_ORIGIN=https://jalen3495-glitch.github.io,https://facevision.js.org
# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
# Optional: protects GET /api/stats
ADMIN_TOKEN=replace-with-a-long-random-secret
